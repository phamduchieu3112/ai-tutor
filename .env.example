# ============================================================================
# AI Tutor – Environment Variables (.env.example)
# Copy this file to .env (local) or add these variables in Vercel Project Settings
# ============================================================================

# 1. Target Admin Email to receive notifications (New User & Payment Requests)
ADMIN_NOTIFICATION_EMAIL=phamduchieu.robotics@gmail.com

# 2. Public Site URL used for deep-links inside notification emails
PUBLIC_SITE_URL=https://ai-tutor.phamduchieu.site

# ----------------------------------------------------------------------------
# EMAIL DELIVERY PROVIDERS (Configure ANY ONE of the options below)
# ----------------------------------------------------------------------------

# OPTION A (Recommended for Vercel): Resend API (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=AI Tutor <onboarding@resend.dev>

# OPTION B (Direct Gmail / SMTP via App Password - Zero external dependencies):
# Create a 16-character Google App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=phamduchieu.robotics@gmail.com
SMTP_PASS=

# OPTION C (Optional Webhook / Google Apps Script / Make / Zapier / n8n):
# Receives JSON POST: { to, subject, html, text, eventType, payload }
EMAIL_WEBHOOK_URL=
