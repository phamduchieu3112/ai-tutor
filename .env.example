# ============================================================================
# AI Tutor - Server-Only Environment Variables (.env.example)
# NEVER commit real secrets or API keys to Git!
# Copy to .env for local testing or configure in Vercel -> Settings -> Environment Variables.
# NEVER prefix any secret below with NEXT_PUBLIC_ or expose it to frontend code.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. ZERO-EXPOSURE ENCRYPTION & AUTHENTICATION (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------------------------
# Generate 64-char hex secret via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=replace-with-64-char-random-hex-secret-at-least-32-bytes
ENCRYPTION_KEY_VERSION=v1
# Optional comma/JSON map of previous secrets for seamless key rotation decryption:
# ENCRYPTION_SECRET_PREVIOUS={"v0":"old-64-char-hex-secret"}

# Google OAuth Client ID (must match client_id used by Google Sign-In)
GOOGLE_CLIENT_ID=480927164540-o3o4h9v5vmi8h93605ridg4eqvtf5rcf.apps.googleusercontent.com

# Admin Allowlist (server-side verified via Google ID token email/sub)
ADMIN_EMAILS=phamduchieurobotics@gmail.com
ADMIN_UIDS=

# Strict CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=https://ai-tutor.phamduchieu.site,https://ai-tutor-two-zeta.vercel.app,http://localhost:5000

# ----------------------------------------------------------------------------
# 2. PROXY FAIR-USE RATE LIMIT, COOLDOWN & CAPS (SYSTEM DEFAULT POOL ONLY)
# ----------------------------------------------------------------------------
AI_PROXY_RATE_LIMIT_PER_HOUR=20
AI_KEY_COOLDOWN_SECONDS=60
AI_PROXY_MAX_TOKENS=8192

# ----------------------------------------------------------------------------
# 3. SERVER-ONLY SYSTEM DEFAULT AI API KEY POOLS (COMMA-SEPARATED PLACEHOLDERS)
# Optional: You can also import keys live in Admin Panel without redeploying.
# ----------------------------------------------------------------------------
DEFAULT_GEMINI_KEYS=
DEFAULT_GROQ_KEYS=
DEFAULT_OPENROUTER_KEYS=
DEFAULT_OPENAI_KEYS=
DEFAULT_DEEPSEEK_KEYS=

# ----------------------------------------------------------------------------
# 4. PERSISTENT SERVERLESS STATE & STORAGE (VERCEL KV / UPSTASH OR SUPABASE)
# Strongly recommended on Vercel so cooldowns, imported keys & rate limits persist across cold starts.
# ----------------------------------------------------------------------------
# Option A: Vercel KV / Upstash Redis REST
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or direct Upstash variables:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Option B: Supabase (Server-Only Service Role Key + URL; run supabase/migrations/001_system_ai_keys_rls.sql)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# 5. AUTOMATED ADMIN EMAIL NOTIFICATIONS (NEW USER & PAYMENT REQUESTS)
# ----------------------------------------------------------------------------
ADMIN_NOTIFICATION_EMAIL=phamduchieu.robotics@gmail.com
PUBLIC_SITE_URL=https://ai-tutor.phamduchieu.site

# Provider Option A (Resend):
RESEND_API_KEY=
EMAIL_FROM=AI Tutor <onboarding@resend.dev>

# Provider Option B (Gmail SMTP App Password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=phamduchieu.robotics@gmail.com
SMTP_PASS=

# Provider Option C (Webhook):
EMAIL_WEBHOOK_URL=
